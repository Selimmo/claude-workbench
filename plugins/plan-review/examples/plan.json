  "tests": [
    {
      "id": "test:1",
      "name": "test_first_hint_is_a_nudge",
      "target": "class:HintPolicy.next_level",
      "behaviour": "With no hints given, the next level is NUDGE"
    },
    {
      "id": "test:2",
      "name": "test_levels_escalate_then_stop",
      "target": "class:HintPolicy.next_level",
      "behaviour": "Levels go NUDGE, APPROACH, WALKTHROUGH, then None"
    },
    {
      "id": "test:3",
      "name": "test_max_hints_caps_the_sequence",
      "target": "class:HintPolicy.max_hints",
      "behaviour": "max_hints=1 gives one NUDGE, then None"
    },
    {
      "id": "test:4",
      "name": "test_request_hint_event_streams_a_hint",
      "target": "class:Orchestrator.give_hint",
      "behaviour": "A RequestHint event streams the LLM's hint to the client and counts it"
    },
    {
      "id": "test:5",
      "name": "test_no_hints_left_is_said_without_calling_the_llm",
      "target": "flow:level/refuse",
      "behaviour": "Past the cap, the agent says so and the LLM is not called"
    }
  ],
  "risks": [
    {
      "id": "risk:1",
      "kind": "risk",
      "text": "Small local models may give away the full solution even at NUDGE level.",
      "severity": "high",
      "mitigation": "Level-specific prompt with an explicit 'do not reveal code' rule; manual probe with the interviewer model."
    },
    {
      "id": "risk:2",
      "kind": "risk",
      "text": "Removing '/hint' breaks anyone used to typing it.",
      "severity": "low",
      "mitigation": "Mention the Hint button in the agent's greeting."
    },
    {
      "id": "risk:3",
      "kind": "question",
      "text": "Should hints count against the candidate's score?",
      "severity": "medium"
    }
  ]
