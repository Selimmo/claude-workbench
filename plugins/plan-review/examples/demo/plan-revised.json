  "tests": [
    {
      "id": "test:1",
      "name": "test_first_hint_is_a_nudge",
      "target": "class:HintPolicy.next_level",
      "behaviour": "With no hints given, the next level is NUDGE"
    },
    {
      "id": "test:2",
      "name": "test_levels_escalate_then_stop",
      "target": "class:HintPolicy.next_level",
      "behaviour": "Levels go NUDGE, APPROACH, WALKTHROUGH, then None"
    },
    {
      "id": "test:3",
      "name": "test_max_hints_caps_the_sequence",
      "target": "class:HintPolicy.max_hints",
      "behaviour": "max_hints=1 gives one NUDGE, then None"
    },
    {
      "id": "test:3b",
      "name": "test_max_hints_comes_from_the_interview_config",
      "target": "class:HintPolicy.from_config",
      "behaviour": "A config with max_hints=5 allows five hints"
    },
    {
      "id": "test:4",
      "name": "test_request_hint_event_streams_a_hint",
      "target": "class:Orchestrator.give_hint",
      "behaviour": "A RequestHint event streams the LLM's hint to the client and counts it"
    },
    {
      "id": "test:5",
      "name": "test_no_hints_left_is_said_without_calling_the_llm",
      "target": "flow:level/refuse",
      "behaviour": "Past the cap, the agent says so and the LLM is not called"
    },
    {
      "id": "test:6",
      "name": "test_each_hint_is_saved_with_its_level",
      "target": "class:SessionStore.save_hint",
      "behaviour": "A given hint is stored with its session and level"
    },
    {
      "id": "test:7",
      "name": "test_hints_lower_the_total",
      "target": "class:ScoreCard.total",
      "behaviour": "Two hints lower the total by twice the penalty"
    },
    {
      "id": "test:8",
      "name": "test_free_text_hint_command_is_gone",
      "target": "class:Orchestrator.parse_command",
      "behaviour": "Typing '/hint' is treated as a normal chat message"
    },
    {
      "id": "test:9",
      "name": "hint button is disabled when no hints are left",
      "target": "class:HintButton.disabled",
