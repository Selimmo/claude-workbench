    "check": "npm run lint && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "elkjs": "^0.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.12"
  }
}
